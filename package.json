{
  "name": "invoicer-cloudflare-workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy --env=\"\"",
    "check:deploy": "npm run build && wrangler deploy --dry-run --env=\"\"",
    "fonts": "node scripts/bundle-fonts.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "decimal.js": "^10.6.0",
    "hono": "^4.9.0",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
